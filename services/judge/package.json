    "dockerode": "^3.3.5"
  },
  "devDependencies": {
    "@code-duel/config": "*",
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.2",
    "@types/dockerode": "^3.3.19",
    "ts-node": "^10.9.1",
    "nodemon": "^3.0.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.6"
  }
