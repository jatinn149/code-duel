{
  "name": "@code-duel/judge",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --watch \"src/**/*.ts\" --watch \"../../packages/*/dist\" --exec \"ts-node -r tsconfig-paths/register src/index.ts\"",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@code-duel/shared": "*",
    "@code-duel/types": "*",
    "@code-duel/validation": "*",
    "bullmq": "^5.76.8",
    "dockerode": "^3.3.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fastq": "^1.20.1",
    "ioredis": "^5.10.1",
    "pino": "^8.14.1",
    "pino-pretty": "^10.0.1"
  },
  "devDependencies": {
    "@code-duel/config": "*",
    "@types/dockerode": "^3.3.19",
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.2",
    "@types/supertest": "^7.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.6",
    "vitest": "^4.1.5"
  }
}
