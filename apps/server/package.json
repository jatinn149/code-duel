{
  "name": "@code-duel/server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node -r tsconfig-paths/register src/index.ts'",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@code-duel/shared": "*",
    "@code-duel/types": "*",
    "@code-duel/validation": "*",
    "express": "^4.18.2",
    "socket.io": "^4.7.1",
    "zod": "^3.21.4",
    "pino": "^8.14.1",
    "pino-pretty": "^10.0.1",
    "dotenv": "^16.3.1",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "cookie-parser": "^1.4.6",
    "jsonwebtoken": "^9.0.1",
    "bcrypt": "^5.1.0"
  },
  "devDependencies": {
    "@code-duel/config": "*",
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.2",
    "@types/socket.io": "^3.0.2",
    "@types/cors": "^2.8.13",
    "@types/cookie-parser": "^1.4.3",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/bcrypt": "^5.0.0",
    "ts-node": "^10.9.1",
    "nodemon": "^3.0.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.6"
  }
}
