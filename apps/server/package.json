{
  "name": "@code-duel/server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "dev": "nodemon --watch \"src/**/*.ts\" --watch \"../../packages/*/dist\" --exec \"ts-node -r tsconfig-paths/register src/index.ts\"",
    "start": "node -r ./register-paths.js dist/index.js",
    "lint": "eslint \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:clear-users": "node -r ./register-paths.js dist/scripts/clear-users.js",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "dependencies": {
    "@code-duel/shared": "*",
    "@code-duel/types": "*",
    "@code-duel/validation": "*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@prisma/client": "^7.8.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^5.1.0",
    "bullmq": "^5.76.8",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dockerode": "^3.3.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.1",
    "helmet": "^7.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.1",
    "pino": "^8.14.1",
    "pino-pretty": "^10.0.1",
    "pino-prisma": "^0.8.8",
    "prisma": "^7.8.0",
    "socket.io": "^4.7.1",
    "uuid": "^14.0.0",
    "zod": "^3.21.4",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@code-duel/config": "*",
    "@types/bcrypt": "^5.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.13",
    "@types/dockerode": "^3.3.19",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.4.2",
    "@types/socket.io": "^3.0.2",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.6",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
