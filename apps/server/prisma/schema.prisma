generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String    @id @default(uuid())
  username                String    @unique
  email                   String    @unique
  playerId                String    @unique
  passwordHash            String
  role                    String    @default("USER")
  tokenVersion            Int       @default(0)
  matchesPlayed           Int       @default(0)
  matchesWon              Int       @default(0)
  rating                  Int       @default(0)
  xp                      Int       @default(0)
  level                   Int       @default(1)
  rank                    String    @default("UNRANKED")
  wins                    Int       @default(0)
  losses                  Int       @default(0)
  streak                  Int       @default(0)
  highestStreak           Int       @default(0)
  highestRating           Int       @default(0)
  dailyChallengeWins      Int       @default(0)
  dailyChallengeBestRank  Int       @default(0)
  dailyWins               Int       @default(0)
  lastDailyWinAt          DateTime?
  streakGraceAvailable    Int       @default(0)
  lastStreakResetAt       DateTime?
  lastDailyResetAt        DateTime?
  status                  String    @default("OFFLINE")
  placementMatchesPlayed  Int       @default(0)
  seasonalTier            String    @default("UNRANKED")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  problemHistories        ProblemHistory[]
  matchResults            MatchPlayerResult[]

  @@index([rating(sort: Desc)])
  @@index([username])
  @@index([playerId])
}

model Problem {
  id                    String   @id @default(uuid())
  title                 String
  description           String
  difficulty            Int
  timeLimit             Int
  memoryLimit           Int
  compatibleModes       String[]
  compatibleRounds      String[]
  speedRating           Int
  pressureRating        Int
  estimatedSolveTimeSec Int
  tags                  String[]
  questionType          String
  questionFamilyId      String?
  realWorldDomain       String?
  initialCode           String?
  solutionCode          String?
  testCases             Json?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  problemHistories      ProblemHistory[]

  @@index([difficulty])
  @@index([questionFamilyId])
}

model ProblemHistory {
  id                String   @id @default(uuid())
  userId            String
  problemId         String
  familyId          String?
  modePlayed        String
  solvedAt          DateTime @default(now())
  result            String
  attempts          Int
  completionSpeedMs Int?

  user              User     @relation(fields: [userId], references: [id])
  problem           Problem  @relation(fields: [problemId], references: [id])

  @@index([userId, problemId])
  @@index([userId, familyId])
}

model MatchResult {
  id          String              @id @default(uuid())
  roomId      String              @unique
  mode        String
  winnerId    String?
  startedAt   DateTime
  endedAt     DateTime            @default(now())
  durationMs  Int
  
  players     MatchPlayerResult[]

  @@index([mode])
  @@index([winnerId])
}

model MatchPlayerResult {
  id            String      @id @default(uuid())
  matchResultId String
  userId        String
  score         Int
  ratingChange  Int
  newRating     Int
  status        String      // 'completed', 'disconnected', 'disqualified'

  matchResult   MatchResult @relation(fields: [matchResultId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([matchResultId])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

model FriendRequest {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  status     String   // 'PENDING', 'ACCEPTED', 'REJECTED'
  createdAt  DateTime @default(now())

  @@unique([fromUserId, toUserId, status])
  @@index([toUserId])
  @@index([fromUserId])
}

model Friendship {
  id        String   @id @default(uuid())
  userId1   String
  userId2   String
  createdAt DateTime @default(now())

  @@unique([userId1, userId2])
  @@index([userId1])
  @@index([userId2])
}
