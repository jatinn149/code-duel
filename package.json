{
  "name": "code-duel-platform",
  "private": true,
  "version": "1.0.0",
  "description": "Production-grade real-time multiplayer coding duel platform",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "infra": "node scripts/infra-up.js",
    "infra:stop": "docker compose down",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky install",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build -d",
    "docker:stop": "docker compose -f docker-compose.prod.yml down"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.3",
    "nodemon": "^3.1.14",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "turbo": "^1.10.12",
    "typescript": "^5.1.6"
  },
  "packageManager": "npm@9.6.7",
  "engines": {
    "node": ">=18.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.21.0"
  }
}
